{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "marionette": {
      "type": "local",
      "command": ["dart", "pub", "global", "run", "marionette_mcp"],
      "enabled": true,
      "environment": {}
    },
    "dart": {
      "type": "local",
      "command": ["dart", "mcp-server", "--log-file=.logs/dart_mcp.log"],
      "enabled": true,
      "environment": {}
    },
    "figma": {
      "enabled": false,
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp"
    }
  },
  "agent": {
    "OpenCopywriter": { "hidden": true },
    "OpenDataAnalyst": { "hidden": true },
    "OpenRepoManager": { "hidden": true },
    "OpenSystemBuilder": { "hidden": true },
    "OpenTechnicalWriter": { "hidden": true }
  }
}
