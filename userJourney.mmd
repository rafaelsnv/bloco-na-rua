flowchart LR
    %% ============================================
    %% USER JOURNEY v3 - Bloco na Rua
    %% Based on actual running app exploration
    %% ============================================

    %% Entry Points
    n0@{ shape: "circle", label: "Start" }
    nDeepLink["DeepLink<br>(push/QR)"]

    %% Auth Flow (assumed from v2, not fully explored)
    n0 --> n1["LoginScreen<br>/login"]
    nDeepLink --> n1
    nDeepLink --> n12["BlockDetails<br>/carnival-block/:id"]
    nDeepLink --> n16["MeetingDetails<br>/meeting/:id"]

    n1 --> n2["SignUpScreen<br>/register"]
    n1 --> nForgot["ForgotPassword<br>/forgot-password"]
    n2 -. back .-> n1
    nForgot -. reset .-> n1

    %% ============================================
    %% Main App Shell
    %% 4 bottom tabs (Settings is separate page)
    %% ============================================
    n4["MainPage<br>/home<br>(Início)"]
    style n0 color:#000000,fill:#C1FF72,stroke:#00BF63

    %% Bottom Navigation (4 tabs)
    n4 --> n5["Blocos<br>/carnival-blocks"]
    n4 --> n6["Reuniões<br>/user-meetings"]
    n4 --> n7["Membros<br>/members"]
    n4 --> n8["Perfil<br>/profile"]

    %% Início tab specific flows
    n4 --> nHomeBlocks["Home: My Blocks<br>(horizontal scroll or list)"]
    n4 --> nHomeMeetings["Home: Upcoming Meetings<br>empty state"]

    %% ============================================
    %% Blocos Flow
    %% ============================================
    n5 --> n5b["Blocos List<br>block cards"]
    n5b --> n10["Criar Bloco<br>/create-block"]
    n5b --> n11["Entrar em Bloco<br>/join-block"]
    n5b --> n12

    n10 --> n12
    n11 --> n12

    n12["BlockDetails<br>/carnival-block/:id<br>🎭 bloco name"]
    n12 --> n13["CreateMeeting<br>/create-meeting/:blockId"]
    n12 --> n14["EditBlock<br>/edit-block/:id"]
    n12 --> n15["AddMember<br>/add-member/:blockId"]
    n12 --> nMeetings["Encontros<br>(meetings list)"]

    nMeetings --> n16

    %% ============================================
    %% Reuniões Flow
    %% ============================================
    n6 --> n6b["Reuniões List<br>search + meeting cards"]
    n6b --> n16

    n16["MeetingDetails<br>/meeting/:id"]
    n16 --> n16b["Ver bloco<br>(link to BlockDetails)"]
    n16b --> n12

    n16 --> n17["EditMeeting<br>/edit-meeting/:id"]
    n16 -. back .-> n6b

    %% RSVP - 2 FABs (present/absent)
    n16 --> nRSVP@{ shape: "diam", label: "Confirmar<br>Presença?" }
    style nRSVP fill:,stroke:#FF914D
    nRSVP --> n19["✓ Presença<br>Confirmada"]
    nRSVP --> n20["✕ Ausente<br>Recusada"]

    %% ============================================
    %% Membros Flow (minimal exploration)
    %% ============================================
    n7 --> n21["Membros List"]

    %% ============================================
    %% Perfil + Settings (separate pages)
    %% ============================================
    n8["Perfil<br>/profile"]
    n8 --> nProfileEdit["EditProfile<br>/edit-profile"]
    n8 --> n8s["Configurações<br>/settings"]
    n8s --> nLogout["ConfirmLogout<br>(modal)"]
    nLogout -. logout .-> n1

    %% Profile shows: avatar, name, email, Tema (Sistema), Telefone, Membro desde

    %% ============================================
    %% FAB Actions (observed)
    %% ============================================
    n5b --> nFAB1["FAB: Create Block?"]
    n6b --> nFAB2["FAB: Create Meeting?"]
    n16 --> nFABPresent["FAB: Mark Present"]
    n16 --> nFABAbsent["FAB: Mark Absent"]

    %% ============================================
    %% Error States
    %% ============================================
    n1 -. error .-> n1
    n10 -. error .-> n10
    n11 -. error .-> n11
    n19 -. error: rede .-> n19_err["Presença Confirmada<br>(retry)"]
    n19_err -. retry .-> n19

    %% ============================================
    %% Success Feedback (dashed return)
    %% ============================================
    n10 -. success .-> n12
    n11 -. success .-> n12
    n13 -. success .-> n12
    n14 -. success .-> n12
    n15 -. success .-> n12
    n17 -. success .-> n16
    n19 -. success .-> n16
    n20 -. success .-> n16

    %% ============================================
    %% Empty States (observed)
    %% ============================================
    n5b -. empty .-> nE1["Empty: No blocks<br>+ Criar | + Entrar"]
    n6b -. empty .-> nE2["Empty: No meetings<br>scheduled"]
    n7 -. empty .-> nE3["Empty: No members<br>added"]
    n4 -. empty .-> nE4["Empty: Bem-vindo!<br>Start by creating a block"]
    n16 -. no RSVPs .-> nE5["Ninguém confirmou<br>presença ainda"]

    %% ============================================
    %% Meeting Card Info (observed)
    %% Shows: title, code (68R3Z4), date, description
    %% ============================================
